{
    "name": "csma",
    "version": "2.2.0",
    "description": "Design-token-first vanilla JS template with modular runtime",
    "type": "module",
    "dependencies": {
        "flexsearch": "^0.7.43"
    },
    "scripts": {
        "dev": "node tooling/scripts/run-dev.js",
        "dev:demo": "node tooling/scripts/run-dev.js demo",
        "dev:showcase": "node tooling/scripts/run-dev.js showcase",
        "build": "vite build",
        "build:prod": "vite build --mode production --minify terser --sourcemap",
        "preview": "vite preview",
        "verify:frontend-routes": "node tooling/scripts/verify-frontend-routes.js",
        "check:design": "node tooling/scripts/check-design.js",
        "check:responsive": "node tooling/scripts/check-responsive.js",
        "check:all": "node tooling/scripts/check-design.js && node tooling/scripts/check-styles.js && node tooling/scripts/check-responsive.js",
        "certify:module": "node tooling/scripts/certify-module.js",
        "api:guide": "npx -y modern-web-guidance@latest",
        "test": "vitest",
        "test:browser-smoke": "playwright test tests/browser/sw-smoke.spec.js",
        "test:browser-console": "playwright test --config playwright.console.config.js",
        "test:contracts": "vitest run tests/contracts.test.js",
        "test:validation": "vitest run tests/validation.test.js",
        "tokens": "node tooling/scripts/generate-tokens.js",
        "tokens:patch": "node tooling/scripts/patch-tokens.js",
        "generate-project-artifacts": "node tooling/scripts/generate-project-artifacts.js",
        "generate:llms-full": "node tooling/scripts/generate-llms-full.js",
        "generate-ai-ui-catalog": "node tooling/scripts/generate-ai-ui-catalog.js",
        "generate-component-reference": "node tooling/scripts/generate-component-reference.js",
        "generate-token-reference": "node tooling/scripts/generate-token-reference.js",
        "generate:events": "node tooling/scripts/generate-events-reference.js",
        "check:graph": "node tooling/scripts/check-graph.js",
        "check:state-vocab": "node tooling/scripts/check-state-vocab.js",
        "check:artifacts": "node tooling/scripts/check-artifacts.js",
        "check:seo-head": "node tooling/scripts/check-seo-head.js",
        "create-component": "node tooling/scripts/create-component.js",
        "create:module": "node tooling/scripts/create-module.js",
        "security-check": "node tooling/scripts/check-security.js",
        "verify": "node tooling/scripts/check-design.js && node tooling/scripts/check-styles.js && node tooling/scripts/check-security.js && node tooling/scripts/check-artifacts.js && node tooling/scripts/check-seo-head.js && vitest run",
        "lint:styles": "node tooling/scripts/check-styles.js"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "fast-check": "^4.9.0",
        "jsdom": "^29.1.1",
        "terser": "^5.49.0",
        "vite": "^8.1.4",
        "vitest": "^4.1.10"
    },
    "keywords": [
        "csma",
        "vanilla-js",
        "design-tokens",
        "microservices",
        "reactive",
        "security",
        "zero-trust"
    ],
    "author": "",
    "license": "MIT"
}
