{
    "name": "csma",
    "version": "2.0.0",
    "description": "Design-token-first vanilla JS template with modular runtime",
    "type": "module",
    "dependencies": {
        "flexsearch": "^0.7.43"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:prod": "vite build --mode production --minify terser --sourcemap",
        "preview": "vite preview",
        "test": "vitest",
        "test:browser-smoke": "playwright test tests/browser/sw-smoke.spec.js",
        "test:contracts": "vitest run tests/contracts.test.js",
        "test:validation": "vitest run tests/validation.test.js",
        "tokens": "node tooling/scripts/generate-tokens.js",
        "tokens:patch": "node tooling/scripts/patch-tokens.js",
        "generate-component-reference": "node tooling/scripts/generate-component-reference.js",
        "generate-token-reference": "node tooling/scripts/generate-token-reference.js",
        "create-component": "node tooling/scripts/create-component.js",
        "security-check": "node tooling/scripts/check-security.js",
        "lint:styles": "node tooling/scripts/check-styles.js"
    },
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "fast-check": "^4.6.0",
        "jsdom": "^27.3.0",
        "terser": "^5.44.1",
        "vite": "^5.0.0",
        "vitest": "^1.0.0"
    },
    "keywords": [
        "csma",
        "vanilla-js",
        "design-tokens",
        "microservices",
        "reactive",
        "security",
        "zero-trust"
    ],
    "author": "",
    "license": "MIT"
}
