{
  "eccac": {
    "version": "1.0.0",
    "spec": "1.0.0"
  },
  "component": {
    "name": "table",
    "type": "III",
    "owner": "ui-service",
    "lifecycle": "active",
    "stability": "stable"
  },
  "contracts": {
    "published": [
      {
        "intent": "INTENT_TABLE_SORT",
        "type": "UI",
        "description": "User requested a table sort change"
      },
      {
        "intent": "TABLE_SELECTION_CHANGED",
        "type": "UI",
        "description": "Row selection changed"
      },
      {
        "intent": "TABLE_ACTION_TRIGGERED",
        "type": "UI",
        "description": "User triggered a table row action"
      }
    ],
    "subscribed": []
  },
  "dependencies": {
    "runtime": ["EventBus"],
    "services": [
      {
        "id": "table",
        "importPath": "/src/services/TableService.js",
        "factory": "createTableService",
        "required": true
      }
    ],
    "components": []
  },
  "metadata": {
    "description": "Interactive table UI for sorting, row selection, and actions",
    "copyRequirements": [
      "Copy src/ui/components/table/*",
      "Copy src/services/TableService.js for managed data behavior",
      "Import src/css/main.css or the table CSS plus theme contract"
    ]
  }
}
