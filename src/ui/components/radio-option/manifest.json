{
  "eccac": { "version": "1.0.0", "spec": "1.0.0" },
  "component": { "name": "radio-option", "type": "I", "owner": "ui-service", "lifecycle": "active", "stability": "stable" },
  "contracts": { "published": [], "subscribed": [] },
  "dependencies": { "runtime": [], "components": [] },
  "metadata": { "description": "Single radio input with label for use inside radio-group" },
  "aiUi": {
    "enabled": true,
    "alias": "radio-option",
    "title": "Radio Option",
    "category": "Forms",
    "preferred": true,
