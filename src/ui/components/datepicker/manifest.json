{
  "eccac": {
    "version": "1.0.0",
    "spec": "1.0.0"
  },
  "component": {
    "name": "datepicker",
    "type": "III",
    "owner": "ui-service",
    "lifecycle": "active",
    "stability": "stable"
  },
  "contracts": {
    "published": [
      {
        "intent": "DATE_SELECTED",
        "type": "UI",
        "description": "User selected a date or date range"
      },
      {
        "intent": "CALENDAR_RENDERED",
        "type": "UI",
        "description": "Calendar view rendered or changed month"
      }
    ],
    "subscribed": []
  },
  "dependencies": {
    "runtime": ["EventBus"],
    "services": [
      {
        "id": "date",
        "importPath": "/src/services/DateService.js",
        "factory": "createDateService",
        "required": true
      }
    ],
    "components": []
  },
  "metadata": {
    "description": "Single and range datepicker with keyboard navigation and modal-style panel",
    "copyRequirements": [
      "Copy src/ui/components/datepicker/*",
      "Copy src/services/DateService.js",
      "Import src/css/main.css or the datepicker CSS plus theme contract"
    ]
  }
}
