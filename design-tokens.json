          "$type": "color"
        },
        "secondary": {
          "$value": {
            "colorSpace": "oklch",
            "components": [0.969, 0.007, 248.0]
          },
          "$type": "color"
        },
        "secondaryForeground": {
          "$value": {
            "colorSpace": "oklch",
